{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Central report triage ledger",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at_utc",
    "findings",
    "ingestion_state"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3.0"
    },
    "updated_at_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "ingestion_state": {
      "type": "object",
      "required": [
        "bootstrap_at_utc",
        "processed_reports"
      ],
      "properties": {
        "bootstrap_at_utc": {
          "type": "string",
          "minLength": 10
        },
        "processed_reports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "task_group",
          "source_family",
          "category",
          "title",
          "status",
          "severity",
          "first_seen_utc",
          "last_seen_utc",
          "occurrence_count",
          "evidence"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 8
          },
          "task_group": {
            "type": "string",
            "pattern": "^ci-[0-9a-f]{16}$",
            "description": "Stable remediation group used by event-driven Worker task creation."
          },
          "source_family": {
            "enum": [
              "lint",
              "github_actions",
              "other"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "investigating",
              "planned",
              "fixing",
              "verifying",
              "resolved",
              "accepted",
              "false_positive",
              "duplicate"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "informational"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "first_seen_utc": {
            "type": "string",
            "minLength": 10
          },
          "last_seen_utc": {
            "type": "string",
            "minLength": 10
          },
          "occurrence_count": {
            "type": "integer",
            "minimum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "report_path",
                "observed_at_utc"
              ],
              "properties": {
                "report_path": {
                  "type": "string",
                  "minLength": 1
                },
                "run_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "observed_at_utc": {
                  "type": "string",
                  "minLength": 10
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "observation_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "resolution": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "fix_commit": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{7,40}$"
              },
              "resolved_at_utc": {
                "type": "string",
                "minLength": 10
              },
              "validation": {
                "type": "object",
                "required": [
                  "run_url",
                  "conclusion",
                  "validated_at_utc"
                ],
                "properties": {
                  "run_url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "conclusion": {
                    "const": "success"
                  },
                  "validated_at_utc": {
                    "type": "string",
                    "minLength": 10
                  }
                },
                "additionalProperties": false
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "fix_commit",
              "resolved_at_utc",
              "validation"
            ]
          },
          "resolution_history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "fix_commit",
                "resolved_at_utc",
                "validation"
              ],
              "properties": {
                "fix_commit": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{7,40}$"
                },
                "resolved_at_utc": {
                  "type": "string",
                  "minLength": 10
                },
                "validation": {
                  "type": "object",
                  "required": [
                    "run_url",
                    "conclusion",
                    "validated_at_utc"
                  ],
                  "properties": {
                    "run_url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "conclusion": {
                      "const": "success"
                    },
                    "validated_at_utc": {
                      "type": "string",
                      "minLength": 10
                    }
                  },
                  "additionalProperties": false
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "duplicate_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "accepted_risk": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "accepted_by": {
                "type": "string",
                "minLength": 1
              },
              "accepted_at_utc": {
                "type": "string",
                "minLength": 10
              },
              "expires_at_utc": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "rationale",
              "accepted_by",
              "accepted_at_utc"
            ]
          },
          "task_refs": {
            "type": "array",
            "description": "Links to Ledger-generated Worker tasks or manually curated task records that address this finding.",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
